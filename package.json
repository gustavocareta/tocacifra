{
    "name": "tocacifra",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Organizador de cifras e repertorios: site + app offline (PWA).",
    "scripts": {
        "start": "node server/index.ts",
        "start:lan": "node server/index.ts --lan",
