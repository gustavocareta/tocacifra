        "fastify": "^5.12.7"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.3",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    }
}
