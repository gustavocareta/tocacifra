{
    "name":  "tocacifra",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "description":  "Organizador de cifras e repertorios: site + app offline (PWA).",
    "scripts":  {
                    "start":  "node server/index.ts",
                    "start:lan":  "node server/index.ts --lan",
                    "dev":  "node --watch server/index.ts",
                    "test":  "node --test",
                    "check":  "tsc --noEmit",
                    "build:vendor":  "node scripts/build-vendor.mjs"
                },
    "dependencies":  {
                         "@fastify/static":  "^10.1.6",
                         "@supabase/supabase-js":  "^2.118.0",
                         "fastify":  "^5.12.7"
                     },
    "devDependencies":  {
                            "@types/node":  "^26.6.5",
                            "esbuild":  "^0.28.2",
                            "typescript":  "^7.0.2"
                        }
}
